{
  "expo": {
    "name": "GROWTH",
    "slug": "growth-strength-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "growth",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nikhildhillon.growth"
    },
    "android": {
      "package": "com.nikhildhillon.growth",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "icon": "./assets/icon.png"
  }
}
